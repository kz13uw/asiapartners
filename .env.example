# Это шаблон файла окружения. 
# На боевом сервере скопируйте этот файл в .env и укажите реальные пароли.

# ==============================
# PostgreSQL
# ==============================
POSTGRES_DB=asia_procurement
POSTGRES_USER=asia_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# ==============================
# FastAPI Backend
# ==============================
# Секретный ключ для JWT токенов (сгенерируйте сложную строку)
SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10 # 10 минут (600 секунд) - требование безопасности

# Строка подключения для базы данных (должна совпадать с PostgreSQL выше)
DATABASE_URL=postgresql+asyncpg://asia_admin:CHANGE_ME_TO_STRONG_PASSWORD@db:5432/asia_procurement

# Строка подключения для Redis
REDIS_URL=redis://redis:6379/0

# Настройки CORS (домены, которым разрешено делать запросы)
# Укажите реальный домен сайта (например, https://tenders.asia.kz)
ALLOWED_ORIGINS=["*"]
